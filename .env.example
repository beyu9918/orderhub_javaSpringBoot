# Copy to .env and replace every placeholder before running docker compose.
DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@orderhub.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional switches (defaults are enabled; coupon Redis follows CACHE_ENABLED).
# CACHE_ENABLED=true
# COUPON_REDIS_ENABLED=true
# TASKS_ENABLED=true
