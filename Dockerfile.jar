# Build the JAR with ./mvnw package before using this runtime-only Dockerfile.
ARG RUNTIME_IMAGE=eclipse-temurin:21-jre-jammy
FROM ${RUNTIME_IMAGE}
USER root
RUN (getent group orderhub || groupadd --system orderhub) && \
    (id orderhub || useradd --system --gid orderhub orderhub) && \
    mkdir -p /app/data/images && chown -R orderhub:orderhub /app/data
WORKDIR /app
COPY target/orderhub-0.0.1-SNAPSHOT.jar app.jar
USER orderhub
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
